# API key for the LLM provider (Anthropic by default)
ANTHROPIC_API_KEY=

# Optional: OpenAI-compatible fallback / LM Studio
# OPENAI_API_KEY=

# Provider: anthropic | openai
# openai = любой OpenAI-compatible endpoint (LM Studio, vLLM, …)
AGENT_PROVIDER=anthropic

# Model written into submission.json "model" and used by the client
AGENT_MODEL=claude-sonnet-5

# --- Local (LM Studio) ---
# AGENT_PROVIDER=openai
# AGENT_MODEL=qwen/qwen3.5-9b
# AGENT_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=lm-studio

# Anthropic-only (ignored when AGENT_PROVIDER=openai)
# output_config.effort: low | medium | high | xhigh | max
AGENT_EFFORT=high

# thinking.type: adaptive (true) | disabled (false). Default true on Claude 5.
AGENT_ADAPTIVE_THINKING=false

# Concurrent LLM requests (asyncio semaphore).
# Code default remains 12 when unset; 24 is the recommended battle-day starting point —
# verify TPM/RPM headroom on your key before the private-set window (×3 corpus).
AGENT_LLM_CONCURRENCY=24

# Extra LLM passes for consistency checks (default false / off).
# true: re-extract loan thresholds once; categorize each account with 3 votes + majority,
# flagging row disagreements (esp. when a disagreeing txn hits a formula numerator/denominator).
# Costs ~+¼ LLM volume on categorization; leave false for cheap warm runs, enable for cold/battle.
AGENT_SELF_CONSISTENCY=true


# Report-only USD pricing for the end-of-run cost table ($ per 1M tokens).
# Claude Sonnet 5 intro rates (through 2026-08-31); standard is 3 / 15 from Sep 1.
AGENT_INPUT_USD_PER_MTOK=2
AGENT_OUTPUT_USD_PER_MTOK=10

# Top-level submission.json fields (filled by the pipeline, never edit by hand)
TEAM_NAME=your-team-name
CONTACT_EMAIL=you@example.com
